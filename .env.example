# Optionnel : lire les données depuis un Google Sheet publié en CSV
# (Fichier > Partager > Publier sur le Web > format CSV)
# Copier ce fichier en .env.local puis décommenter :
# VITE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/XXXXXXXX/pub?output=csv

# Supabase : URL et clé publishable du projet (les droits sont limités par RLS)
# VITE_SUPABASE_URL=https://XXXXXXXX.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
